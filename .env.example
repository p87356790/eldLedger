# eldLedger environment template
# Copy to `.env` and adjust values before production use.
# `docker compose up` works with the defaults below even without a `.env` file.

# Application
APP_NAME=eldLedger
APP_ENV=production
TZ=Asia/Seoul

# Security — start.bat / start.sh 가 처음 실행 때 임의의 값으로 바꿉니다. 직접 복사할 때도 꼭 바꾸세요.
SECRET_KEY=change-me-in-production

# SQLite inside the backend container (host path: ./data/database/eldledger.db)
DATABASE_URL=sqlite:////data/database/eldledger.db

# CORS (comma-separated). Browser access is via the frontend on port 8080.
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# In-app scheduled backups (설정 → 데이터 백업/복원). 30-day purge is always on.
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_INTERVAL_SECONDS=60

# Published ports on the host. Use 8080 in the browser.
# Backend 8000 is bound to localhost only; LAN/인터넷 접속은 8080 만 쓰면 됩니다.
BACKEND_PORT=8000
FRONTEND_PORT=8080
